# Copy to deploy/.env before running `docker compose up`.
# Anything marked REQUIRED has no safe default; compose will refuse to start without it.

# --- REQUIRED secrets ---
INTERNAL_HMAC_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# --- Storage root for dataset + model artifacts (bind-mounted into api/worker/beat) ---
# On a prod host this is typically /srv/water. For local dev, point to the repo checkout.
DATA_ROOT=/srv/water

# --- Waltr integration ---
WALTR_BASE_URL=https://api.waltr.in
WALTR_DEFAULT_LOCATION_ID=638
WALTR_SERVICE_TOKEN=

# JWT verification (Next.js -> Waltr)
WALTR_JWKS_URL=https://auth.waltr.in/.well-known/jwks.json
WALTR_JWT_ISSUER=https://auth.waltr.in
WALTR_JWT_AUDIENCE=waltr-app
# Optional: set if Waltr uses a namespaced role claim (e.g. "https://waltr.in/role").
WALTR_ROLE_CLAIM=
# Origin allowed to iframe-embed /forecast (leave empty for same-origin only).
WALTR_EMBED_ORIGIN=https://app.waltr.in

# --- Web ---
NEXT_PUBLIC_BASE_PATH=/forecast
DEV_AUTH_BYPASS=false

# --- Nginx ports (override if host ports are taken) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_CERT_DIR=./tls

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO
