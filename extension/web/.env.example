NEXT_PUBLIC_BASE_PATH=/forecast

# Trust boundary between Next.js and FastAPI
API_BASE_URL=http://api:8000
INTERNAL_HMAC_SECRET=dev-only-change-me

# Waltr JWT verification
WALTR_JWKS_URL=https://auth.waltr.in/.well-known/jwks.json
WALTR_JWT_ISSUER=https://auth.waltr.in
WALTR_JWT_AUDIENCE=waltr-app

# Dev-only: when true and WALTR_JWKS_URL is unset, trust the x-dev-role header
DEV_AUTH_BYPASS=false
